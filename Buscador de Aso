import time
import tkinter as tk
from tkinter import scrolledtext, messagebox
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from selenium.webdriver.support.ui import WebDriverWait, Select
from selenium.webdriver.support import expected_conditions as EC
from selenium.webdriver.common.action_chains import ActionChains
import undetected_chromedriver as uc


def iniciar_processo():
    usuario = entry_usuario.get().strip()
    senha = entry_senha.get().strip()
    cpfs = text_area.get("1.0", tk.END).strip().split("\n")
    cpfs = [cpf.strip() for cpf in cpfs if cpf.strip()]

    if not usuario or not senha:
        messagebox.showwarning("Campos obrigatórios", "Informe o usuário e a senha antes de iniciar.")
        return
    if not cpfs:
        messagebox.showwarning("Campos obrigatórios", "Informe ao menos um CPF.")
        return

    # Configuração do WebDriver
    options = uc.ChromeOptions()
    options.add_argument("--no-first-run --no-service-autorun --password-store=basic")
    driver = uc.Chrome(options=options)
    wait = WebDriverWait(driver, 30)
    actions = ActionChains(driver)

    # 1) Abrir a página e efetuar o login
    driver.get("https://seu.acesso.io/brmed/Search.aspx")

    usuario_input = wait.until(EC.visibility_of_element_located((By.ID, "signInSafeDoc_txtUserName")))
    usuario_input.send_keys(usuario)

    senha_input = wait.until(EC.visibility_of_element_located((By.ID, "signInSafeDoc_txtPassword")))
    senha_input.send_keys(senha)
    senha_input.send_keys(Keys.RETURN)

    wait.until(EC.url_contains("Search.aspx"))
    time.sleep(5)

    # 2) Duplo clique em "CONCREMAT"
    concretmat_element = wait.until(EC.element_to_be_clickable((By.XPATH, "//span[contains(text(),'CONCREMAT')]")))
    actions.double_click(concretmat_element).perform()
    time.sleep(1)

    # 3) Duplo clique em "Administrativo"
    administrativo_element = wait.until(EC.element_to_be_clickable((By.XPATH, "//span[contains(text(),'Administrativo')]")))
    actions.double_click(administrativo_element).perform()
    time.sleep(1)

    # 4) Duplo clique em "Aso"
    aso_element = wait.until(EC.element_to_be_clickable((By.XPATH, "//span[contains(text(),'Aso')]")))
    actions.double_click(aso_element).perform()
    time.sleep(1)

    # 5) Selecionar no <select> CP_59 a opção CONTENDO (valor "7")
    cp_select = wait.until(EC.visibility_of_element_located((By.ID, "CP_59")))
    select_obj = Select(cp_select)
    select_obj.select_by_value("7")
    time.sleep(1)

    # 6 e 7) Inserir o primeiro CPF no campo IDX_59 e clicar em "Executar Busca"
    cpf_input = wait.until(EC.visibility_of_element_located((By.ID, "IDX_59")))
    cpf_input.clear()
    cpf_input.send_keys(cpfs[0])
    botao_busca = driver.find_element(By.ID, "_ctl0_ContentPlaceHolder_btnSearch")
    botao_busca.click()
    time.sleep(1)

    # 8) Loop condicional para tratar os casos para cada CPF
    for cpf in cpfs:
        driver.get("https://seu.acesso.io/brmed/Search.aspx")
        time.sleep(2)

        aso_element = wait.until(EC.element_to_be_clickable((By.XPATH, "//span[contains(text(),'Aso')]")))
        actions.double_click(aso_element).perform()
        time.sleep(1)

        cpf_input = wait.until(EC.visibility_of_element_located((By.ID, "IDX_59")))
        cpf_input.clear()
        cpf_input.send_keys(cpf)
        botao_busca = driver.find_element(By.ID, "_ctl0_ContentPlaceHolder_btnSearch")
        botao_busca.click()
        time.sleep(1)

        if "Não foram encontrados registros utilizando os critérios acima." in driver.page_source:
            print(f"[{cpf}] Nenhum registro encontrado.")
            continue
        elif not driver.find_elements(By.CSS_SELECTOR, "i.fa-download[title='Download']"):
            print(f"[{cpf}] Botão de download não visível. Clicando no primeiro link de ASO...")
            links = driver.find_elements(By.PARTIAL_LINK_TEXT, "Aso - Nome")
            if links:
                links[0].click()
                time.sleep(1)
                botao_download = wait.until(EC.element_to_be_clickable(
                    (By.CSS_SELECTOR, "i.fa-download[title='Download']")
                ))
                botao_download.click()
                time.sleep(1)
            continue
        elif driver.find_elements(By.CSS_SELECTOR, "i.fa-download[title='Download']"):
            print(f"[{cpf}] Botão de download visível. Clicando para baixar...")
            botao_download = driver.find_element(By.CSS_SELECTOR, "i.fa-download[title='Download']")
            botao_download.click()
            time.sleep(1)
            continue



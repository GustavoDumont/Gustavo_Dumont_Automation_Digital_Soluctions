# Interface gráfica Tkinter
# =========================
root = tk.Tk()
root.title("Busca de ASOs por CPF")
root.geometry("400x400")

frame_login = tk.Frame(root)
frame_login.pack(pady=10)

tk.Label(frame_login, text="Usuário:").grid(row=0, column=0, sticky="e", padx=5, pady=2)
entry_usuario = tk.Entry(frame_login, width=30)
entry_usuario.grid(row=0, column=1, pady=2)

tk.Label(frame_login, text="Senha:").grid(row=1, column=0, sticky="e", padx=5, pady=2)
entry_senha = tk.Entry(frame_login, show="*", width=30)
entry_senha.grid(row=1, column=1, pady=2)

def toggle_senha():
    if entry_senha.cget("show") == "":
        entry_senha.config(show="*")
        botao_toggle.config(text="Mostrar")
    else:
        entry_senha.config(show="")
        botao_toggle.config(text="Ocultar")

botao_toggle = tk.Button(frame_login, text="Mostrar", command=toggle_senha, width=8)
botao_toggle.grid(row=1, column=2, padx=5)

label_cpfs = tk.Label(root, text="Insira os CPFs (um por linha):")
label_cpfs.pack(pady=5)

text_area = scrolledtext.ScrolledText(root, width=50, height=10)
text_area.pack(padx=10, pady=5)

botao_iniciar = tk.Button(root, text="Iniciar", command=iniciar_processo)
botao_iniciar.pack(pady=10)

root.mainloop()
